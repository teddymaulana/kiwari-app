# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tesseract.js language models — committed under tessdata/ (bundled into the
# deployment so OCR doesn't depend on a runtime CDN download, see
# next.config.ts outputFileTracingIncludes); ignore any stray ones elsewhere
*.traineddata
!/tessdata/*.traineddata

.env.local.example

# plaintext warga login credentials, read by the "Kirim Info Login" action
warga_credentials.csv

# QA data snapshot/restore scripts — operational, not app code, kept local only
/supabase/qa/
